{
  "info": {
    "_postman_id": "8f09f6c1-76e5-4df0-8b58-6a6d1b1f3a91",
    "name": "Insurance API - Basic Tests",
    "description": "Alapszintu Postman tesztek az Insurance API jelenlegi /api route-jaihoz.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5012"
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "buildingId",
      "value": ""
    },
    {
      "key": "countryId",
      "value": ""
    },
    {
      "key": "countyId",
      "value": ""
    },
    {
      "key": "cityId",
      "value": ""
    },
    {
      "key": "identificationNumber",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Clients",
      "item": [
        {
          "name": "Create client",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('identificationNumber', String(Date.now()).slice(-13));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Response contains client id', function () { pm.expect(body.id).to.be.a('string').and.not.empty; });",
                  "pm.collectionVariables.set('clientId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientType\": 0,\n  \"name\": \"Postman Client\",\n  \"identificationNumber\": \"{{identificationNumber}}\",\n  \"email\": \"postman@example.com\",\n  \"phone\": \"+40712345678\",\n  \"address\": \"Postman Street 1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clients"
              ]
            }
          }
        },
        {
          "name": "Search clients",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/clients?searchTerm=Postman",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clients"
              ],
              "query": [
                {
                  "key": "searchTerm",
                  "value": "Postman"
                }
              ]
            }
          }
        },
        {
          "name": "Get client by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returned id matches requested id', function () { pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('clientId')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/clients/{{clientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clients",
                "{{clientId}}"
              ]
            }
          }
        },
        {
          "name": "Update client",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Name was updated', function () { pm.expect(pm.response.json().name).to.eql('Postman Client Updated'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientType\": 0,\n  \"name\": \"Postman Client Updated\",\n  \"identificationNumber\": \"{{identificationNumber}}\",\n  \"email\": \"updated@example.com\",\n  \"phone\": \"+40712345679\",\n  \"address\": \"Updated Street 2\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/clients/{{clientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clients",
                "{{clientId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Geography",
      "item": [
        {
          "name": "Get countries",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });",
                  "const countries = pm.response.json();",
                  "if (!pm.collectionVariables.get('countryId') && countries.length > 0) pm.collectionVariables.set('countryId', countries[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/geography/countries"
          }
        },
        {
          "name": "Get counties by country",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });",
                  "const counties = pm.response.json();",
                  "if (!pm.collectionVariables.get('countyId') && counties.length > 0) pm.collectionVariables.set('countyId', counties[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/geography/countries/{{countryId}}/counties"
          }
        },
        {
          "name": "Get cities by county",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });",
                  "const cities = pm.response.json();",
                  "if (!pm.collectionVariables.get('cityId') && cities.length > 0) pm.collectionVariables.set('cityId', cities[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/geography/counties/{{countyId}}/cities"
          }
        }
      ]
    },
    {
