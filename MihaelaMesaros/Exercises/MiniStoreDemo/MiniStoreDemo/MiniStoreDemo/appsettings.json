      //  "Name": "File",
      //  "Args": {
      //    "path": "logs/app-.log",
      //    "rollingInterval": "Day",
      //    "retainedFileCountLimit": 30
      //  }
      //}
    ]
  },

  "LoggingSettings": {
    "LogFolder": "applogs",
    "LogFileNameInfo": "info-.log",
    "LogFileNameError": "error-.log",
    "LogFileNameAudit": "audit-.log"
  },

  "AllowedHosts": "*"

}
