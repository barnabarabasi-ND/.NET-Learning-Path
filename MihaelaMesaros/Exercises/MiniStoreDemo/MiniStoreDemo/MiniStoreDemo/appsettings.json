{
  "ConnectionStrings": {
    "MiniStoreDemoConnStr": "Server=(localdb)\\MSSQLLocalDB;Database=MiniStoreDemo;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Jwt": {
    "Issuer": "MiniStoreDemo",
    "Audience": "MiniStoreDemo.Client",
    "Key": "DEMO-ONLY-CHANGE-TO-SECRET-KEY-1234567890"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },

    "WriteTo": [
      {
        "Name": "Console"
      }
